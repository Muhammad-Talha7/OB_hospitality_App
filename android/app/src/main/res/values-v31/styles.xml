<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Make the mandatory Android 12+ system splash invisible so only
             the Flutter SplashScreen widget is ever visible to the user. -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <!-- No icon = nothing shown on the OS splash -->
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Zero duration so it exits immediately -->
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
